[Unit]
Description=MCP Longitudinal Assurance Storage v2 bounded runtime discovery
Documentation=file:/opt/mcp-observatory/current/docs/automatic-runtime-coverage-v1.md
Wants=network-online.target docker.service
After=network-online.target docker.service mcp-observatory-v2-refresh.service

[Service]
Type=oneshot
User=mcp-refresh
Group=mcp-refresh
SupplementaryGroups=mcp-catalog docker
WorkingDirectory=/opt/mcp-observatory/current

Environment=MCPO_PROJECT_DIR=/opt/mcp-observatory/current
Environment=MCPO_V2_STATE_DIR=/var/lib/mcp-observatory-v2
Environment=MCPO_NATIVE_GUARD_ROOT=/opt/mcp-native-guard/current
Environment=MCPO_RUNTIME_BATCH_SIZE=10
Environment=MCPO_RUNTIME_MAXIMUM_RUN_SECONDS=3000
Environment=MCPO_RUNTIME_PHASE_TIMEOUT_SECONDS=180
Environment=MCPO_RUNTIME_CHILD_TIMEOUT_SECONDS=720
Environment=MCPO_RUNTIME_MAXIMUM_ATTEMPTS=3
Environment=MCPO_RUNTIME_RETRY_FAILED_AFTER_SECONDS=86400
Environment=MCPO_RUNTIME_STALE_RUNNING_AFTER_SECONDS=7200

ExecStart=/bin/bash /opt/mcp-observatory/current/scripts/run_storage_v2_runtime_batch.sh

UMask=0027
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/mcp-observatory-v2
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=link-local

TimeoutStartSec=3300
KillMode=control-group
KillSignal=SIGTERM
SendSIGKILL=yes
