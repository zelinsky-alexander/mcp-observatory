[Unit]
Description=MCP Observatory bounded static artifact analysis
Documentation=file:/opt/mcp-observatory/docs/bulk-static-analysis.md
Wants=network-online.target
After=network-online.target mcp-observatory-refresh.service

[Service]
Type=oneshot
User=mcp-analysis
Group=mcp-analysis
SupplementaryGroups=mcp-catalog docker
WorkingDirectory=/opt/mcp-observatory/current
Environment=MCPO_PROJECT_DIR=/opt/mcp-observatory/current
Environment=MCPO_BINARY=/opt/mcp-observatory/current/build/release/mcp-observatory
Environment=MCPO_DATABASE=/var/lib/mcp-observatory/catalog/local-registry.sqlite
Environment=MCPO_EVIDENCE_ROOT=/var/lib/mcp-observatory/evidence
Environment=MCPO_STATIC_ANALYSIS_RULES=/opt/mcp-observatory/current/rules/artifact-static-analysis-v1.json
Environment=MCPO_STATIC_ANALYSIS_BATCH_SIZE=1000
Environment=MCPO_STATIC_ANALYSIS_MAXIMUM_RUN_SECONDS=3000
Environment=MCPO_STATIC_ANALYSIS_CHILD_TIMEOUT_SECONDS=300
Environment=MCPO_STATIC_ANALYSIS_MAXIMUM_ATTEMPTS=3
Environment=MCPO_STATIC_ANALYSIS_RETRY_FAILED_AFTER_SECONDS=86400
Environment=MCPO_STATIC_ANALYSIS_STALE_RUNNING_AFTER_SECONDS=3600
ExecStart=/bin/bash /opt/mcp-observatory/current/scripts/run_static_analysis_queue.sh
UMask=0027

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/mcp-observatory
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=link-local

TimeoutStartSec=55min
KillMode=control-group
KillSignal=SIGTERM
SendSIGKILL=yes

[Install]
WantedBy=multi-user.target
