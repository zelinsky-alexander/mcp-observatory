[Unit]
Description=MCP Observatory incremental registry refresh
Documentation=file:/opt/mcp-observatory/docs/registry-maintenance.md
Wants=network-online.target
After=network-online.target
OnSuccess=mcp-observatory-static-analysis.service

[Service]
Type=oneshot
User=mcp-observatory
Group=mcp-observatory
WorkingDirectory=/opt/mcp-observatory
Environment=MCPO_PROJECT_DIR=/opt/mcp-observatory
Environment=MCPO_BINARY=/opt/mcp-observatory/build/release/mcp-observatory
Environment=MCPO_DATABASE=/var/lib/mcp-observatory/local-registry.sqlite
Environment=MCPO_REFRESH_RUNTIME_DIR=/var/lib/mcp-observatory/registry-refresh
Environment=MCPO_LOCAL_TIMEZONE=UTC
Environment=MCPO_BACKUP_RETENTION_COUNT=2
ExecStart=/opt/mcp-observatory/scripts/daily_registry_refresh.sh
StateDirectory=mcp-observatory
StateDirectoryMode=0700
UMask=0077

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/mcp-observatory
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=link-local

TimeoutStartSec=20min
KillMode=control-group
KillSignal=SIGTERM
SendSIGKILL=yes

[Install]
WantedBy=multi-user.target
