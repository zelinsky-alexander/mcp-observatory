[Unit]
Description=MCP Observatory incremental registry refresh
Documentation=file:/opt/mcp-observatory/current/docs/registry-maintenance.md
Wants=network-online.target
After=network-online.target
OnSuccess=mcp-observatory-static-analysis.service

[Service]
Type=oneshot
User=mcp-refresh
Group=mcp-refresh
SupplementaryGroups=mcp-catalog
WorkingDirectory=/opt/mcp-observatory/current
Environment=MCPO_PROJECT_DIR=/opt/mcp-observatory/current
Environment=MCPO_BINARY=/opt/mcp-observatory/current/build/release/mcp-observatory
Environment=MCPO_DATABASE=/var/lib/mcp-observatory/catalog/local-registry.sqlite
Environment=MCPO_REFRESH_RUNTIME_DIR=/var/lib/mcp-observatory/registry-refresh
Environment=MCPO_LOCAL_TIMEZONE=Asia/Jerusalem
Environment=MCPO_BACKUP_RETENTION_COUNT=2
Environment=MCPO_CATALOG_GROUP=mcp-catalog
ExecStart=/bin/bash /opt/mcp-observatory/current/scripts/daily_registry_refresh.sh
UMask=0027

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/mcp-observatory
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=link-local

TimeoutStartSec=20min
KillMode=control-group
KillSignal=SIGTERM
SendSIGKILL=yes

[Install]
WantedBy=multi-user.target
