[Unit]
Description=MCP Longitudinal Assurance Storage v2 bounded static analysis
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=mcp-refresh
Group=mcp-refresh
SupplementaryGroups=mcp-catalog docker
WorkingDirectory=/opt/mcp-storage-v2-test/mcp-observatory

Environment=MCPO_PROJECT_DIR=/opt/mcp-storage-v2-test/mcp-observatory
Environment=MCPO_V2_STATE_DIR=/var/lib/mcp-observatory-v2
Environment=MCPO_V2_BATCH_SIZE=25
Environment=MCPO_V2_MAXIMUM_RUN_SECONDS=1800
Environment=MCPO_V2_CHILD_TIMEOUT_SECONDS=300

ExecStart=/bin/bash /opt/mcp-storage-v2-test/mcp-observatory/scripts/run_storage_v2_static_batch.sh

Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=2100
